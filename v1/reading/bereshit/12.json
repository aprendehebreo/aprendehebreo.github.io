{"libro":{"slug":"bereshit","he":"בְּרֵאשִׁית","es":"Génesis","en":"Genesis","section":"torah"},"capitulo":12,"versiculos":[{"n":1,"he":"וַיֹּ֤אמֶר יְהוָה֙ אֶל אַבְרָ֔ם לֶךְ לְךָ֛ מֵאַרְצְךָ֥ וּמִמּֽוֹלַדְתְּךָ֖ וּמִבֵּ֣ית אָבִ֑יךָ אֶל הָאָ֖רֶץ אֲשֶׁ֥ר אַרְאֶֽךָּ","audio":"audio/verso-bereshit-12-1.mp3","he_plain":"ויאמר יהוה אל אברם לך לך מארצך וממולדתך ומבית אביך אל הארץ אשר אראך","es":"EMPERO Jehová había dicho á Abram: Vete de tu tierra y de tu parentela, y de la casa de tu padre, á la tierra que te mostraré;","palabras":[{"he":"וַיֹּ֤אמֶר","plano":"ויאמר","strong":"H559","morph":"HC/Vqw3ms","xlit":"ʼâmar","glosa_es":"decir; dijo"},{"he":"יְהוָה֙","plano":"יהוה","strong":"H3068","morph":"HNp","xlit":"Yᵉhôvâh","glosa_es":"YHVH; el Señor"},{"he":"אֶל","plano":"אל","strong":"H413","morph":"HR","xlit":"ʼêl","glosa_es":"hacia; a; para"},{"he":"אַבְרָ֔ם","plano":"אברם","strong":"H87","morph":"HNp","xlit":"ʼAbrâm","glosa_es":"Abraham (nombre propio: Abram)"},{"he":"לֶךְ","plano":"לך","strong":"H3212","morph":"HVqv2ms","xlit":"yâlak","glosa_es":"ir; caminar"},{"he":"לְךָ֛","plano":"לך","strong":"","morph":"HR/Sp2ms","xlit":"","glosa_es":""},{"he":"מֵאַרְצְךָ֥","plano":"מארצך","strong":"H776","morph":"HR/Ncbsc/Sp2ms","xlit":"ʼerets","glosa_es":"tierra; país"},{"he":"וּמִמּֽוֹלַדְתְּךָ֖","plano":"וממולדתך","strong":"H4138","morph":"HC/R/Ncfsc/Sp2ms","xlit":"môwledeth","glosa_es":"parentela; lugar de origen"},{"he":"וּמִבֵּ֣ית","plano":"ומבית","strong":"H1004","morph":"HC/R/Ncmsc","xlit":"bayith","glosa_es":"casa; familia"},{"he":"אָבִ֑יךָ","plano":"אביך","strong":"H1","morph":"HNcmsc/Sp2ms","xlit":"ʼâb","glosa_es":"padre"},{"he":"אֶל","plano":"אל","strong":"H413","morph":"HR","xlit":"ʼêl","glosa_es":"hacia; a; para"},{"he":"הָאָ֖רֶץ","plano":"הארץ","strong":"H776","morph":"HTd/Ncbsa","xlit":"ʼerets","glosa_es":"tierra; país"},{"he":"אֲשֶׁ֥ר","plano":"אשר","strong":"H834","morph":"HTr","xlit":"ʼăsher","glosa_es":"que; el cual; quien"},{"he":"אַרְאֶֽךָּ","plano":"אראך","str