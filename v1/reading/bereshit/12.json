":"H1129","morph":"HC/Vqw3ms","xlit":"bânâh","glosa_es":"construir; edificar"},{"he":"שָׁם֙","plano":"שם","strong":"H8033","morph":"HD","xlit":"shâm","glosa_es":"allí; allá"},{"he":"מִזְבֵּ֔חַ","plano":"מזבח","strong":"H4196","morph":"HNcmsa","xlit":"mizbêach","glosa_es":"altar"},{"he":"לַיהוָ֖ה","plano":"ליהוה","strong":"H3068","morph":"HR/Np","xlit":"Yᵉhôvâh","glosa_es":"YHVH; el Señor"},{"he":"הַנִּרְאֶ֥ה","plano":"הנראה","strong":"H7200","morph":"HTd/VNrmsa","xlit":"râʼâh","glosa_es":"ver; mirar"},{"he":"אֵלָֽיו","plano":"אליו","strong":"H413","morph":"HR/Sp3ms","xlit":"ʼêl","glosa_es":"hacia; a; para"}]},{"n":8,"he":"וַיַּעְתֵּ֨ק מִשָּׁ֜ם הָהָ֗רָה מִקֶּ֛דֶם לְבֵֽית אֵ֖ל וַיֵּ֣ט אָהֳלֹ֑ה בֵּֽית אֵ֤ל מִיָּם֙ וְהָעַ֣י מִקֶּ֔דֶם וַיִּֽבֶן שָׁ֤ם מִזְבֵּ֨חַ֙ לַֽיהוָ֔ה וַיִּקְרָ֖א בְּשֵׁ֥ם יְהוָֽה","audio":"audio/verso-bereshit-12-8.mp3","he_plain":"ויעתק משם ההרה מקדם לבית אל ויט אהלה בית אל מים והעי מקדם ויבן שם מזבח ליהוה ויקרא בשם יהוה","es":"Y pasóse de allí á un monte al oriente de Bethel, y tendió su tienda, teniendo á Bethel al occidente y Hai al oriente: y edificó allí altar á Jehová, é invocó el nombre de Jehová.","palabras":[{"he":"וַיַּעְתֵּ֨ק","plano":"ויעתק","strong":"H6275","morph":"HC/Vhw3ms","xlit":"ʻâthaq","glosa_es":"moverse; avanzar; envejecer"},{"he":"מִשָּׁ֜ם","plano":"משם","strong":"H8033","morph":"HR/D","xlit":"shâm","glosa_es":"allí; allá"},{"he":"הָהָ֗רָה","plano":"ההרה","strong":"H2022","morph":"HTd/Ncmsa/Sd","xlit":"har","glosa_es":"monte; montaña"},{"he":"מִקֶּ֛דֶם","plano":"מקדם","strong":"H6924","morph":"HR/Ncmsa","xlit":"qedem","glosa_es":"oriente; antiguo; delante"},{"he":"לְבֵֽית","plano":"לבית","strong":"","morph":"HR/Np","xlit":"","glosa_es":""},{"he":"אֵ֖ל","plano":"אל","strong":"H1008","morph":"HNp","xlit":"Bêyth-ʼÊl","glosa_es":"Betel (casa de Dios)"},{"he":"וַיֵּ֣ט","plano":"ויט","strong":"H5186","morph":"HC/Vqw3ms","xlit":"nâṭâh","glosa_es":"extender; inclinar"},{"he":"אָהֳלֹ֑ה","plano":"אהלה","strong":"H168","morph":"HNcmsc/Sp