rph":"HC/Vprmsc/Sp2ms","xlit":"qâlal","glosa_es":"ser ligero; maldecir"},{"he":"אָאֹ֑ר","plano":"אאר","strong":"H779","morph":"HVqi1cs","xlit":"ʼârar","glosa_es":"maldecir"},{"he":"וְנִבְרְכ֣וּ","plano":"ונברכו","strong":"H1288","morph":"HC/VNp3cp","xlit":"bârak","glosa_es":"bendecir; bendito"},{"he":"בְךָ֔","plano":"בך","strong":"","morph":"HR/Sp2ms","xlit":"","glosa_es":""},{"he":"כֹּ֖ל","plano":"כל","strong":"H3605","morph":"HNcmsc","xlit":"kôl","glosa_es":"todo; cada; entero"},{"he":"מִשְׁפְּחֹ֥ת","plano":"משפחת","strong":"H4940","morph":"HNcfpc","xlit":"mishpâchâh","glosa_es":"familia; clan"},{"he":"הָאֲדָמָֽה","plano":"האדמה","strong":"H127","morph":"HTd/Ncfsa","xlit":"ʼădâmâh","glosa_es":"tierra; suelo; terreno"}]},{"n":4,"he":"וַיֵּ֣לֶךְ אַבְרָ֗ם כַּאֲשֶׁ֨ר דִּבֶּ֤ר אֵלָיו֙ יְהוָ֔ה וַיֵּ֥לֶךְ אִתּ֖וֹ ל֑וֹט וְאַבְרָ֗ם בֶּן חָמֵ֤שׁ שָׁנִים֙ וְשִׁבְעִ֣ים שָׁנָ֔ה בְּצֵאת֖וֹ מֵחָרָֽן","audio":"audio/verso-bereshit-12-4.mp3","he_plain":"וילך אברם כאשר דבר אליו יהוה וילך אתו לוט ואברם בן חמש שנים ושבעים שנה בצאתו מחרן","es":"Y fuése Abram, como Jehová le dijo; y fué con él Lot: y era Abram de edad de setenta y cinco años cuando salió de Harán.","palabras":[{"he":"וַיֵּ֣לֶךְ","plano":"וילך","strong":"H3212","morph":"HC/Vqw3ms","xlit":"yâlak","glosa_es":"ir; caminar"},{"he":"אַבְרָ֗ם","plano":"אברם","strong":"H87","morph":"HNp","xlit":"ʼAbrâm","glosa_es":"Abraham (nombre propio: Abram)"},{"he":"כַּאֲשֶׁ֨ר","plano":"כאשר","strong":"H834","morph":"HR/Tr","xlit":"ʼăsher","glosa_es":"que; el cual; quien"},{"he":"דִּבֶּ֤ר","plano":"דבר","strong":"H1696","morph":"HVpp3ms","xlit":"dâbar","glosa_es":"hablar"},{"he":"אֵלָיו֙","plano":"אליו","strong":"H413","morph":"HR/Sp3ms","xlit":"ʼêl","glosa_es":"hacia; a; para"},{"he":"יְהוָ֔ה","plano":"יהוה","strong":"H3068","morph":"HNp","xlit":"Yᵉhôvâh","glosa_es":"YHVH; el Señor"},{"he":"וַיֵּ֥לֶךְ","plano":"וילך","strong":"H3212","morph":"HC/Vqw3ms","xlit":"yâlak","glosa_es":"ir; caminar"},{"he":"אִתּ֖וֹ","plano":"אתו","strong":"H854