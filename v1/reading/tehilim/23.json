ms/Sp1cs","xlit":"nâhal","glosa_es":"guiar; conducir con cuidado"}]},{"n":3,"he":"נַפְשִׁ֥י יְשׁוֹבֵ֑ב יַֽנְחֵ֥נִי בְמַעְגְּלֵי צֶ֝֗דֶק לְמַ֣עַן שְׁמֽוֹ","audio":"audio/verso-tehilim-23-3.mp3","he_plain":"נפשי ישובב ינחני במעגלי צדק למען שמו","es":"Confortará mi alma; guiaráme por sendas de justicia por amor de su nombre.","palabras":[{"he":"נַפְשִׁ֥י","plano":"נפשי","strong":"H5315","morph":"HNcbsc/Sp1cs","xlit":"nephesh","glosa_es":"alma; vida; persona"},{"he":"יְשׁוֹבֵ֑ב","plano":"ישובב","strong":"H7725","morph":"HVoi3ms","xlit":"shûwb","glosa_es":"volver; regresar; responder"},{"he":"יַֽנְחֵ֥נִי","plano":"ינחני","strong":"H5148","morph":"HVhi3ms/Sp1cs","xlit":"nâchâh","glosa_es":"guiar; conducir"},{"he":"בְמַעְגְּלֵי","plano":"במעגלי","strong":"H4570","morph":"HR/Ncmpc","xlit":"maʻgâl","glosa_es":"sendero; carril"},{"he":"צֶ֝֗דֶק","plano":"צדק","strong":"H6664","morph":"HNcmsa","xlit":"tsedeq","glosa_es":"justicia; rectitud"},{"he":"לְמַ֣עַן","plano":"למען","strong":"H4616","morph":"HR","xlit":"maʻan","glosa_es":"para que; a fin de"},{"he":"שְׁמֽוֹ","plano":"שמו","strong":"H8034","morph":"HNcmsc/Sp3ms","xlit":"shêm","glosa_es":"nombre"}]},{"n":4,"he":"גַּ֤ם כִּֽי אֵלֵ֨ךְ בְּגֵ֪יא צַלְמָ֡וֶת לֹא אִ֘ירָ֤א רָ֗ע כִּי אַתָּ֥ה עִמָּדִ֑י שִׁבְטְךָ֥ וּ֝מִשְׁעַנְתֶּ֗ךָ הֵ֣מָּה יְנַֽחֲמֻֽנִי","audio":"audio/verso-tehilim-23-4.mp3","he_plain":"גם כי אלך בגיא צלמות לא אירא רע כי אתה עמדי שבטך ומשענתך המה ינחמני","es":"Aunque ande en valle de sombra de muerte, no temeré mal alguno; porque tú estarás conmigo: tu vara y tu cayado me infundirán aliento.","palabras":[{"he":"גַּ֤ם","plano":"גם","strong":"H1571","morph":"HTa","xlit":"gam","glosa_es":"también; además"},{"he":"כִּֽי","plano":"כי","strong":"H3588","morph":"HC","xlit":"kîy","glosa_es":"porque; pues; que"},{"he":"אֵלֵ֨ךְ","plano":"אלך","strong":"H3212","morph":"HVqi1cs","xlit":"yâlak","glosa_es":"ir; caminar"},{"he":"בְּגֵ֪יא","plano":"בגיא","strong":"H1516","morph":"HR/Ncbsc","xlit":"gayʼ","glosa_es":"valle; barranco"